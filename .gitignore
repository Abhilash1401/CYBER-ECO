# ==========================================
# Cyber Eco - Comprehensive .gitignore
# ==========================================

# --- Environment & Sensitive Files ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Django Specific ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
!backend/media/.gitkeep
staticfiles/
collected_static/

# --- Testing & Quality Tools ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/

# --- Node.js & Frontend ---
frontend/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.next/
.next/
frontend/out/
out/
.vercel
*.tsbuildinfo
next-env.d.ts.bak

# --- Editors & IDEs ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Docker & Compose ---
*.pid
docker-compose.override.yml

# --- MinIO & Local S3 Storage ---
minio_data/
