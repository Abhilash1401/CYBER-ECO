# === PostgreSQL ===
POSTGRES_DB=cybereco
POSTGRES_USER=cybereco_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Django ===
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_50_char_random_string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MFA_ENCRYPTION_KEY=CHANGE_ME_32_byte_base64_fernet_key

# === MinIO (S3-compatible) ===
MINIO_ROOT_USER=cybereco_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_STORAGE_BUCKET_NAME=cybereco-evidence
AWS_ACCESS_KEY_ID=cybereco_minio
AWS_SECRET_ACCESS_KEY=CHANGE_ME_minio_password
AWS_STORAGE_BUCKET_NAME=cybereco-evidence
AWS_S3_ENDPOINT_URL=http://minio:9000

# === Email (Mailpit) ===
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# === Celery ===
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# === Frontend ===
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
